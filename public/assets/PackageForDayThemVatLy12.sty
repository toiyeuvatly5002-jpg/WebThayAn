		% Định nghĩa sẵn style cho 4 ô vuông để code gọn hơn, màu chữ mặc định là đỏ (text=red)
		box ans/.style={fill=white, draw=myorange, line width=1pt, rounded corners=4pt, minimum size=0.95cm, anchor=west, font=\Large\bfseries, text=red}
		]
		% Hàng tiêu đề "KẾT QUẢ:"
		\node[
		fill=myorange, text=white, font=\bfseries\sffamily,
		rounded corners=6pt, minimum height=0.7cm,
		text width=6.8cm, align=center
		] (head_kq) {\large KẾT QUẢ:};
		
		% Khung nền dưới
		\node[
		fill=bglightorange, draw=myorange!40, line width=0.6pt,
		rounded corners=8pt, minimum height=1.3cm,
		text width=6.8cm, anchor=north,
		yshift=-3pt
		] (bg_box) at (head_kq.south) {};
		
		% Vị trí ô vuông đầu tiên
		\coordinate (box1_left) at ([xshift=1.9cm]bg_box.west);
		
		% Căn giữa Icon vào khoảng trống bên trái
		\node at ($ (bg_box.west)!0.5!(box1_left) $) {%
			\includegraphics[height=1.1cm]{#1}%
		};
		
		% 4 ô vuông đáp án (Truyền lần lượt #2, #3, #4, #5 vào)
		\node[box ans] at ([xshift=0*1.15cm]box1_left) {#2};
		\node[box ans] at ([xshift=1*1.15cm]box1_left) {#3};
		\node[box ans] at ([xshift=2*1.15cm]box1_left) {#4};
		\node[box ans] at ([xshift=3*1.15cm]box1_left) {#5};
	\end{tikzpicture}%
	\par\vspace{0.1cm}%
}

