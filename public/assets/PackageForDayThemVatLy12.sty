\newcommand{\headertableDS}{%
	\par\vspace{0.2cm}\noindent
	\begin{tikzpicture}[every node/.style={inner sep=0pt, outer sep=0pt}]
		% Tiêu đề Phát biểu
		\node[
		fill=myorange, text=white, font=\bfseries,
		rounded corners=5pt, minimum height=0.75cm,
		text width=\dimexpr\textwidth-2.8cm\relax, align=center
		] (h_pb) {Phát biểu};
		
		% Tiêu đề Đúng
		\node[
		fill=myorange, text=white, font=\bfseries,
		rounded corners=5pt, minimum height=0.75cm,
		text width=1.2cm, align=center,
		xshift=4pt, right=0pt of h_pb
		] (h_d) {Đúng};
		
		% Tiêu đề Sai
		\node[
		fill=myorange, text=white, font=\bfseries,
		rounded corners=5pt, minimum height=0.75cm,
		text width=1.2cm, align=center,
		xshift=4pt, right=0pt of h_d
		] (h_s) {Sai};
	\end{tikzpicture}%
	\par\vspace{0.08cm}
}

\newcommand{\phatbieuDS}[3]{% Thay đổi thành 3 đối số (thêm đối số #3)
	\noindent
	\begin{tikzpicture}[every node/.style={inner sep=0pt, outer sep=0pt}]
		% 1. Ô Phát biểu (Khung nội dung chính)
		\node[
		fill=bgcard, draw=bordercard, line width=0.5pt,
		rounded corners=5pt, minimum height=0.85cm,
		text width=\dimexpr\textwidth-2.8cm-12pt\relax, align=left,
		inner xsep=6pt, inner ysep=6pt
		] (b_pb) {{\color{myorange}\bfseries #1)} #2};
		
		% 2. Ô Đúng
		\node[
		fill=bgcard, draw=bordercard, line width=0.5pt,
		rounded corners=5pt,
		fit={(b_pb.north) (b_pb.south)}, 
		text width=1.2cm,
		anchor=north west
		] (b_d) at ([xshift=4pt]b_pb.north east) {};
		
		% 3. Ô Sai (Thêm tên node là b_s để dễ dàng chèn tick vào giữa)
		\node[
		fill=bgcard, draw=bordercard, line width=0.5pt,
		rounded corners=5pt,
		fit={(b_pb.north) (b_pb.south)}, 
		text width=1.2cm,
		anchor=north west
		] (b_s) at ([xshift=4pt]b_d.north east) {};
		
		% 4. Xử lý đánh dấu tick (Màu đỏ, size to)
		% Nếu đối số #3 là Đ -> Đánh dấu vào giữa ô b_d
		\ifthenelse{\equal{#3}{Đ}}{
			\node at (b_d.center) {\color{red}\LARGE $\checkmark$};
		}{}
		
		% Nếu đối số #3 là S -> Đánh dấu vào giữa ô b_s
		\ifthenelse{\equal{#3}{S}}{
			\node at (b_s.center) {\color{red}\LARGE $\checkmark$};
		}{}
	\end{tikzpicture}%
	\par\vspace{0.08cm}
}

\newenvironment{bangdungsai}{%
	\headertableDS
}{%
	\par\vspace{0.15cm}
}
