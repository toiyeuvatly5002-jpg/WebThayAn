\newcommand{\KhungDeThi}[2]{% #1: Thời gian, #2: Mã đề
	\par\noindent\vspace{0.2cm}
	\begin{tcolorbox}[
		enhanced,
		colback=bgcard,           % Màu nền xanh pastel nhạt
		colframe=blueNavy,        % Viền màu xanh đậm
		arc=8pt,                  % Bo góc tròn
		boxrule=1.2pt,            % Độ dày viền
		left=4pt, right=8pt,      
		top=6pt, bottom=6pt,      
		sidebyside,               
		sidebyside align=center,  
		sidebyside gap=10pt,      
		lefthand width=3.0cm,     % Giữ nguyên độ rộng ô điểm số
		segmentation style={solid, blueNavy, line width=1.2pt} 
		]
		
		% ----------------- Ô TRÁI: ĐIỂM SỐ -----------------
		\begin{center}
			\tikz \node[fill=blueNavy, text=white, font=\bfseries\small,
			rounded corners=4pt, inner xsep=8pt, inner ysep=4pt] {ĐIỂM SỐ};
			\par\vspace{0.2cm}
			\tikz \node[draw=blueNavy, dashed, line width=1pt, rounded corners=5pt,
			minimum width=2.4cm, minimum height=1.6cm] {};
		\end{center}
		
		\tcblower
		% ----------------- Ô PHẢI: THÔNG TIN ĐỀ THI -----------------
		\renewcommand{\arraystretch}{1.6} % TĂNG độ giãn dòng (từ 1.35 lên 1.6)
		\normalsize 
		
		% THU HẸP khoảng trống cột chứa dấu chấm (từ 0.8cm xuống 0.3cm) để sát chữ hơn
		\begin{tabularx}{\linewidth}{>{\centering\arraybackslash}m{0.3cm} l X @{}}
			\tikz[baseline=-0.5ex]\draw[myorange, fill=myorange] (0,0) circle (2pt); & \textbf{\textcolor{blueNavy}{Họ và tên học sinh:}} & \dotfill \\
			\tikz[baseline=-0.5ex]\draw[myorange, fill=myorange] (0,0) circle (2pt); & \textbf{\textcolor{blueNavy}{Lớp:}} & \dotfill \\
			\tikz[baseline=-0.5ex]\draw[myorange, fill=myorange] (0,0) circle (2pt); & \textbf{\textcolor{blueNavy}{Thời gian làm bài:}} & \textbf{#1} \\
			\tikz[baseline=-0.5ex]\draw[myorange, fill=myorange] (0,0) circle (2pt); & \textbf{\textcolor{blueNavy}{Mã đề:}} & \textbf{\textcolor{myred}{#2}} \\
		\end{tabularx}
	\end{tcolorbox}
	\par\vspace{0.4cm}
}
