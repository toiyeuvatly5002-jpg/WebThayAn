% Định nghĩa lệnh \vekhungcham{số dòng}{khoảng cách}
\newcommand{\vekhungcham}[2]{%
	\vspace{-0.5cm}
	\par\begingroup
	\setlength{\baselineskip}{#2}%
	\setlength{\lineskiplimit}{-\maxdimen}%
	\setlength{\parskip}{0pt}%
	
	\setcounter{tongdong}{#1}%
	\setcounter{sodong}{0}%
	
	\foreach \i in {1,...,#1} {%
		\stepcounter{sodong}%
		\noindent
		\makebox[0.48\textwidth]{\dotfill}%
		\hfill
		\begin{tikzpicture}[baseline=0pt, inner sep=0pt, outer sep=0pt]
			\ifnum\value{sodong}=\value{tongdong}%
			% === DÒNG CUỐI CÙNG ===
			% Chỉnh con số -0.2cm này để co/giãn đuôi đường thẳng theo ý muốn
			\draw (0, 0.25cm) -- (0, -0.2cm);
			\else%
			% === CÁC DÒNG BÌNH THƯỜNG TRÊN ===
			\draw (0, 0.25cm) -- (0, -#2);
			\fi%
		\end{tikzpicture}%
		\hfill
		\makebox[0.48\textwidth]{\dotfill}\par
	}%
	\endgroup
	\par\vspace{0.3cm}%
}

% Định nghĩa lệnh \khung{nội dung} màu xanh blue
\newcommand{\khung}[1]{%
	\begin{tcolorbox}[
		breakable,                   % Tự động ngắt sang trang khi hết hàng/hết trang
		colback=blue!5!white,        % Màu nền xanh nhạt
		colframe=blue!75!black,      % Màu viền xanh blue đậm
		arc=3mm,                     % Độ bo góc
		boxrule=1pt,                 % Độ dày đường viền
		left=8pt, right=8pt, top=8pt, bottom=8pt % Khoảng cách đệm bên trong
		]
		#1
	\end{tcolorbox}%
}

