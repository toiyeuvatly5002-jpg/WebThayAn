%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%code trắc nghiệm 4 hàng có 4 hình
\newcommand{\phuonganhinh}[9][0.22]{%
	\par\vspace{0.2cm}\noindent
	\begin{tabular*}{\linewidth}{@{\extracolsep{\fill}} c c c c @{}}
		\includegraphics[width=#1\textwidth]{#2} &
		\includegraphics[width=#1\textwidth]{#3} &
		\includegraphics[width=#1\textwidth]{#4} &
		\includegraphics[width=#1\textwidth]{#5} %
		% Kiểm tra nếu có ít nhất 1 nhãn được điền thì mới xuống dòng hiện nhãn
		\ifthenelse{\equal{#6}{}\and\equal{#7}{}\and\equal{#8}{}\and\equal{#9}{}}{}{%
			\\[4pt]
			#6 & #7 & #8 & #9
		}%
	\end{tabular*}%
	\par\vspace{0.2cm}%
}
